# ============================================================
# Petra Cafe Restaurant — Ortam Değişkenleri
# Kopyala: copy .env.example .env.local
# ============================================================

# Sunucu (lokal)
PORT=3010
NODE_ENV=production

# ----------------------------------------------------------------
# Admin Girişi (Vercel demo için zorunlu)
# ----------------------------------------------------------------
ADMIN_EMAIL=demo@petra.local
ADMIN_PASSWORD=change-me
# İlk kurulumda true; kullanıcı oluşturduktan sonra false yapın.
ALLOW_ENV_ADMIN=false

# JWT — ZORUNLU (min 32 karakter)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Site URL — yayın için zorunlu (sitemap, Open Graph, canonical)
SITE_URL=https://your-project.netlify.app
HTTPS_ENABLED=true

# Netlify: Site settings → Environment variables
#   JWT_SECRET (32+ karakter, üretimde zayıf değer reddedilir)
#   SITE_URL=https://<site-adiniz>.netlify.app
#   ALLOW_ENV_ADMIN=true
#   ADMIN_EMAIL / ADMIN_PASSWORD  (ilk giriş; sonra init-admin)
# Build command: npm run build:vercel  (netlify.toml)

# Müşteri JWT (opsiyonel; yoksa JWT_SECRET — cookie adı admin'den ayrıdır)
# CUSTOMER_JWT_SECRET=

# ----------------------------------------------------------------
# SMTP — e-posta doğrulama + sipariş onayı
# ----------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Petra Cafe Restaurant <noreply@example.com>"

# ----------------------------------------------------------------
# Veritabanı — Vercel'de admin KAYIT için zorunlu (Neon ücretsiz)
# Site sadece okumak için JSON ile de açılır.
# ----------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/petra?sslmode=require
# Sonra lokalden bir kez:
#   npm run db:setup
#   npm run db:migrate

# Vercel Blob — görsel yükleme (Vercel Dashboard → Storage → Blob)
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ----------------------------------------------------------------
# Entegrasyonlar (Trendyol Go / Yemeksepeti)
# Credential'lar Admin → Entegrasyonlar ekranından şifreli saklanır.
# JWT_SECRET, AES-GCM anahtarı türetmek için kullanılır.
# ----------------------------------------------------------------
# INTEGRATIONS_CRYPTO_SECRET=  # opsiyonel; yoksa JWT_SECRET
# Trendyol Meal GW: https://api.trendyol.com/mealgw
# Yemeksepeti Partner: https://yemeksepeti.partner.deliveryhero.io
