# ==============================================================================
# PETRA CAFE & RESTAURANT — VERCEL & PRODUCTION ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# 1. VERİTABANI (PostgreSQL / Neon / Supabase / Vercel Postgres)
# ------------------------------------------------------------------------------
# PostgreSQL bağlantı dizesi (Eğer verilmezse otomatik JSON fallback çalışır).
# Örnek: postgresql://user:password@ep-cool-tree.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# 2. ADMİN & GÜVENLİK (Zorunlu / Önerilen)
# ------------------------------------------------------------------------------
# JWT & Session imzalama gizli anahtarı (32+ karakter rastgele metin)
AUTH_SECRET=petra_super_secret_jwt_key_2026_production
ADMIN_SECRET=petra_super_secret_jwt_key_2026_production

# İlk admin kullanıcısı (Opsiyonel — panelden de oluşturulabilir)
ADMIN_USER=admin
ADMIN_PASS=Petra2026!

# 3. SMTP E-POSTA BİLDİRİM AYARLARI (Müşteri Onay/Red & Yönetici Bildirimleri)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=petracaferestaurant@gmail.com
# Gmail kullanıyorsanız 16 haneli 'Uygulama Şifresi' (App Password) giriniz:
SMTP_PASS=
SMTP_FROM="Petra Cafe & Restaurant <petracaferestaurant@gmail.com>"
SMTP_SECURE=false

# 4. TELEGRAM ANLIK BİLDİRİM BOTU (Rezervasyon & İletişim Formu Bildirimleri)
# ------------------------------------------------------------------------------
# BotFather'dan aldığınız bot token'ı:
TELEGRAM_BOT_TOKEN=
# Bildirimin düşeceği Telegram Chat ID (veya grup ID):
TELEGRAM_CHAT_ID=

# 5. PAYTR SANAL POS & 3D SECURE ÖDEME ENTEGRASYONU
# ------------------------------------------------------------------------------
# PayTR panelinizden alacağınız mağaza bilgileri (Admin panelinden de girilebilir)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = Test Modu (Gerçek para çekmez), 0 = Canlı Mod
PAYTR_TEST_MODE=1

# 6. SİTE URL & CANLI ADRES
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://petra-cafe-site.vercel.app