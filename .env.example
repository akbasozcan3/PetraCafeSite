# ============================================================
# Petra Cafe Restaurant — Ortam Değişkenleri
# Lokal: copy .env.example .env.local
# ============================================================

PORT=3010
NODE_ENV=production

# ----------------------------------------------------------------
# Admin
# ----------------------------------------------------------------
ADMIN_EMAIL=demo@petra.local
ADMIN_PASSWORD=change-me
# Vercel ilk giriş: true. Admin kullanıcı oluşunca false yapın.
ALLOW_ENV_ADMIN=true

# JWT — ZORUNLU (min 32 karakter)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

SITE_URL=https://your-project.vercel.app
HTTPS_ENABLED=true

# ----------------------------------------------------------------
# Vercel yayın (Dashboard → Settings → Environment Variables)
# ----------------------------------------------------------------
# 1) JWT_SECRET
# 2) SITE_URL = https://<proje>.vercel.app
# 3) DATABASE_URL = Neon / Vercel Postgres connection string (sslmode=require)
# 4) Storage → Blob → BLOB_READ_WRITE_TOKEN (otomatik gelebilir)
# 5) ALLOW_ENV_ADMIN=true
# 6) ADMIN_EMAIL / ADMIN_PASSWORD
#
# Build: npm run build:vercel
# Tablolar ilk istekte otomatik kurulur; content.json boş DB'ye kopyalanır.
# Admin → görsel yükleme Blob'a gider, kaydet Postgres'e yazılır.

# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# SMTP — rezervasyon / iletişim e-postası (Vercel Production + Preview)
# Gmail: smtp.gmail.com, 587, SMTP_SECURE=false, SMTP_PASS = 16 haneli uygulama şifresi
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_FROM="Petra Cafe <you@gmail.com>"
# SMTP_TO=you@gmail.com

# Telegram — token'ı git'e yazmayın. Grup chat id genelde -100...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
