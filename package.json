{
  "name": "firincitasdelen",
  "version": "2.0.0",
  "private": true,
  "description": "Taşdelen Fırıncı — Next.js web + admin",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "node scripts/sync-public.mjs && next build && node scripts/prepare-standalone.mjs",
    "build:vercel": "node scripts/sync-public.mjs && next build",
    "sync-public": "node scripts/sync-public.mjs",
    "prepare-standalone": "node scripts/prepare-standalone.mjs",
    "start": "next start -p 3010",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run typecheck && npm run build:vercel",
    "init-admin": "node -r ./scripts/load-env.cjs scripts/init-admin.mjs",
    "seed-content": "node -r ./scripts/load-env.cjs scripts/seed-content.mjs",
    "import-menu": "node -r ./scripts/load-env.cjs scripts/import-menu.mjs",
    "db:setup": "node -r ./scripts/load-env.cjs scripts/db-setup.mjs",
    "db:migrate": "node -r ./scripts/load-env.cjs scripts/db-migrate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/pg": "^8.20.4",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
